# Shell scripts are deployed to a Linux host from a Windows workstation. They
# must keep LF endings — a CRLF shebang line makes bash fail with an opaque
# "\r: command not found", and scripts/deploy.sh compares file hashes across
# the two machines, so a rewritten line ending would also make every file look
# changed on every deploy.
*.sh text eol=lf
*.service text eol=lf

# Source is edited on Windows and run on Linux: keep it LF everywhere.
*.ts text eol=lf
*.tsx text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
