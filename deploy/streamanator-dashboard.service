[Unit]
Description=Streamanator TypeScript dashboard
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=arm
Group=arm
WorkingDirectory=/home/arm/projects/streamanator_dashboard/web
Environment=NODE_ENV=production
Environment=HOSTNAME=0.0.0.0
Environment=PORT=8600
Environment=PATH=/home/arm/.local/node-current/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=ENV_FILE_PATH=/home/arm/projects/streamanator_dashboard/.env
EnvironmentFile=-/home/arm/projects/streamanator_dashboard/.env
ExecStart=/home/arm/.local/node-current/bin/node /home/arm/projects/streamanator_dashboard/web/node_modules/next/dist/bin/next start --hostname 0.0.0.0 --port 8600
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
# SMART reads are restricted by the host sudoers allowlist to read-only
# smartctl JSON commands. NoNewPrivileges would prevent that allowlist working.
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/arm/projects/streamanator_dashboard/var -/home/arm/projects/streamanator_dashboard/.env

[Install]
WantedBy=multi-user.target
