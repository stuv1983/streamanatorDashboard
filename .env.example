# Streamanator Dashboard configuration template.
#
# Copy to `.env` and fill in. NEVER commit the real .env — it holds API keys.
#   cp .env.example .env && chmod 600 .env
#
# Every value below is optional. The dashboard runs with none of them set,
# using the live-verified defaults in config.py, and shows NOT CONFIGURED for
# whatever is missing rather than failing.

# ---------------------------------------------------------------------------
# Host identity
# ---------------------------------------------------------------------------
STREAMANATOR_HOST=streamanator
STREAMANATOR_ADDR=10.0.40.100
STREAMANATOR_USER=arm
STREAMANATOR_TZ=Australia/Melbourne
# `nproc` on the host. Load average is judged against this.
STREAMANATOR_CPU_CORES=24

# ---------------------------------------------------------------------------
# Dashboard
# ---------------------------------------------------------------------------
# 8600 was free on this host as of 13 Aug 2026. Verify with `ss -lntup` before
# changing. Do NOT expose this port through WAN NAT.
DASHBOARD_PORT=8600
DASHBOARD_BIND=0.0.0.0
DASHBOARD_REFRESH_SECONDS=30
DASHBOARD_DEFAULT_RANGE=24h

# Local time-series store. Provides deltas and forecasts while Prometheus is
# absent, and keeps running as a backstop once it is deployed.
HISTORY_DB_PATH=/home/arm/projects/streamanator_dashboard/var/history.sqlite3
HISTORY_RETENTION_DAYS=400
HISTORY_SAMPLE_INTERVAL=60

LOG_LEVEL=INFO
# Leave blank to log to stdout only (captured by journald under systemd).
LOG_FILE=

# ---------------------------------------------------------------------------
# Prometheus and friends
# ---------------------------------------------------------------------------
# NOT DEPLOYED as of the 13 Aug 2026 survey — no listener on 9090, no
# prometheus container. Deploy deploy/monitoring-stack/ then set this.
PROMETHEUS_URL=
PROMETHEUS_TIMEOUT=4
PROMETHEUS_STALE_AFTER=180

# Enables "Open in Grafana" deep links. Also not deployed yet.
GRAFANA_URL=

# Blackbox Exporter. When set, probes come from Prometheus with history
# instead of being run at page load.
BLACKBOX_URL=

# ---------------------------------------------------------------------------
# UniFi
# ---------------------------------------------------------------------------
# PREFERRED: run unpoller (deploy/monitoring-stack/) and let Prometheus scrape
# it. Credentials then live in the unpoller environment, never here, and the
# dashboard reads UniFi data straight out of Prometheus. Leave these blank.
UNIFI_EXPORTER_URL=
#
# PREFERRED: the Network Integration API, authenticated with an API key. The
# key does not go through the login flow, so email MFA on the account stays
# enabled — set it from Admin → API keys, or here. Create the key at the
# console's Settings → Control Plane → Integrations. Verified live against
# application version 10.5.67; the firewall-policies endpoint 500s on that
# firmware (a UniFi bug), so the dashboard uses firewall zones instead.
#
# The key carries WRITE scope (UniFi issues only one scope). The dashboard
# only ever sends GET — enforced by test — but store the key like a password.
UNIFI_CONTROLLER_URL=https://10.0.0.1
UNIFI_API_KEY=
UNIFI_SITE=default
# TLS verification. false trusts the console's self-signed certificate. Better:
# point UNIFI_CA_BUNDLE at the console's exported certificate so the write-
# scoped key is only ever sent to the authenticated peer. Export it with:
#   openssl s_client -connect 10.0.0.1:443 </dev/null 2>/dev/null \
#     | openssl x509 > unifi-console.pem
UNIFI_VERIFY_TLS=false
# UNIFI_CA_BUNDLE=/home/arm/projects/streamanator_dashboard/unifi-console.pem

# ---------------------------------------------------------------------------
# Local collectors
# ---------------------------------------------------------------------------
LOCAL_COLLECTORS=true
LOCAL_COMMAND_TIMEOUT=5
DOCKER_SOCKET=/var/run/docker.sock

# SMART needs root. The dashboard user has no passwordless sudo by default, so
# this stays false until deploy/sudoers-smartctl is installed (or you deploy
# the smartctl_exporter container, which is the better option).
SMARTCTL_SUDO=false
SMARTCTL_PATH=/usr/sbin/smartctl

# ---------------------------------------------------------------------------
# Storage / RAID
# ---------------------------------------------------------------------------
RAID_DEVICE=md127
RAID_REQUIRED_MEMBERS=4
# Disk with the documented UDMA CRC history — gets delta-focused display.
CRC_WATCH_SERIAL=WPV2E6LL

# ---------------------------------------------------------------------------
# Service endpoints (live-verified 13 Aug 2026)
# ---------------------------------------------------------------------------
PLEX_URL=http://10.0.40.100:32400
IMMICH_URL=http://10.0.40.100:2283
# Sports Data Lab listens on 6969, NOT 8501. Port 8501 is AquaLog.
SPORTS_DATA_LAB_URL=http://10.0.40.100:6969
AQUALOG_URL=http://10.0.40.100:8501
# All media-stack ports are published by the gluetun container.
SABNZBD_URL=http://10.0.40.100:8080
SONARR_URL=http://10.0.40.100:8081
RADARR_URL=http://10.0.40.100:8082
PROWLARR_URL=http://10.0.40.100:8085
QBITTORRENT_URL=http://10.0.40.100:8086

# ---------------------------------------------------------------------------
# API credentials — SECRETS. Never commit these.
# ---------------------------------------------------------------------------
# Populate automatically with: sudo ./scripts/extract_api_keys.sh >> .env
PLEX_TOKEN=
SONARR_API_KEY=
RADARR_API_KEY=
PROWLARR_API_KEY=
SABNZBD_API_KEY=
QBITTORRENT_USER=
QBITTORRENT_PASSWORD=

# Optional: richer Plex session data.
TAUTULLI_URL=
TAUTULLI_API_KEY=

# Gluetun's HTTP control server requires auth from v3.40 onward.
GLUETUN_CONTROL_URL=http://10.0.40.100:8000
GLUETUN_API_KEY=

# ---------------------------------------------------------------------------
# VPN
# ---------------------------------------------------------------------------
GLUETUN_CONTAINER=media-vpn_gluetun_1
VPN_PROVIDER=nordvpn
VPN_PROTOCOL=openvpn
VPN_IP_CHECK_URL=https://ipinfo.io/json
WAN_IP_CHECK_URL=https://ipinfo.io/json

# ---------------------------------------------------------------------------
# Backups
# ---------------------------------------------------------------------------
SPORTS_BACKUP_DIR=/mnt/media/sportsDBackUp
NIGHTLY_BACKUP_DIR=/mnt/backup/nightly
SPORTS_DATA_LAB_PATH=/home/arm/projects/sports_data_lab

# ---------------------------------------------------------------------------
# Threshold overrides (all optional — defaults are in health/thresholds.py)
# ---------------------------------------------------------------------------
# TH_FS_WARNING=80
# TH_FS_CRITICAL=95
# TH_DISK_TEMP_WARNING=50
# TH_DISK_TEMP_CRITICAL=55
# TH_CRC_DELTA_WARNING=1
# TH_BACKUP_WARNING_DAYS=4
# TH_BACKUP_CRITICAL_DAYS=7
# TH_LATENCY_WARNING=100

# ---------------------------------------------------------------------------
# Admin console
# ---------------------------------------------------------------------------
# The monitoring pages are open; the Admin section requires a sign-in. Create
# the first account over SSH — there is no web setup wizard, deliberately:
#
#     .venv/bin/python scripts/admin_bootstrap.py init
#
# It creates an admin account and prints ten single-use break-glass recovery
# codes once. Store those off this server.

# Where accounts and the audit trail live. Both are written at mode 0600 and
# sit under var/, which is gitignored.
# ADMIN_ACCOUNTS_PATH=/home/arm/projects/streamanator_dashboard/var/accounts.json
# ADMIN_AUDIT_PATH=/home/arm/projects/streamanator_dashboard/var/audit.log

# Shown in authenticator apps during TOTP enrolment.
# ADMIN_TOTP_ISSUER=Streamanator Dashboard

# Master switch for privileged actions. Set false to make the console
# configuration-only: credentials and probes stay editable, but every action
# renders as a command to run over SSH instead of a button that executes.
# ADMIN_ACTIONS_ENABLED=true

# Require a sign-in for the monitoring pages too, not just Admin. Off by
# default — gating the wall display was not the point. Turn this on if the
# dashboard ever becomes reachable from a VLAN you do not trust, though the
# standing advice is still not to expose it.
# REQUIRE_AUTH_FOR_ALL=false

# Overlay for user-managed service probes.
# PROBES_CONFIG_PATH=/home/arm/projects/streamanator_dashboard/var/probes.json
